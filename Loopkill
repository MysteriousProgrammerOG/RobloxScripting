-- ============================
-- 👥 Player Button Factory
-- ============================

local function createPlayerButton(plr)
	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(1, -12, 0, 26)
	btn.Text = plr.Name
	btn.Font = Enum.Font.Gotham
	btn.TextSize = 13
	btn.AutoButtonColor = false

	btn.BackgroundColor3 = Color3.fromRGB(18, 12, 12)
	btn.TextColor3 = Color3.fromRGB(255, 215, 215)

	Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 10)

	local stroke = Instance.new("UIStroke", btn)
	stroke.Thickness = 1
	stroke.Color = Color3.fromRGB(255, 80, 80)
	stroke.Transparency = 0.45

	btn.MouseButton1Click:Connect(function()
		local list = getgenv().configs.TargetList
		local idx = table.find(list, plr)

		if idx then
			table.remove(list, idx)
			btn.BackgroundColor3 = Color3.fromRGB(18, 12, 12)
			stroke.Color = Color3.fromRGB(255, 80, 80)
		else
			table.insert(list, plr)
			btn.BackgroundColor3 = Color3.fromRGB(45, 20, 20)
			stroke.Color = Color3.fromRGB(255, 100, 100)
		end
	end)

	return btn
end

local function UpdatePlayers()
	for _, c in ipairs(PlayerFrame:GetChildren()) do
		if c:IsA("TextButton") then
			c:Destroy()
		end
	end

	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= lp then
			createPlayerButton(p).Parent = PlayerFrame
		end
	end
end

-- Toggle panel
AuraBtn.MouseButton1Click:Connect(function()
	PlayerFrame.Visible = not PlayerFrame.Visible
	if PlayerFrame.Visible then
		UpdatePlayers()
	end
end)

Players.PlayerAdded:Connect(UpdatePlayers)
Players.PlayerRemoving:Connect(UpdatePlayers)

-- ============================
-- ⚡ OPTIMIZED TARGET AURA CORE
-- ============================

local lastFire = 0
local FIRE_RATE = 1/35 -- stable sweet spot

local MAX_PARTS_PER_TARGET = 4

local function getTargets()
	local t = {}

	for _, plr in ipairs(getgenv().configs.TargetList) do
		local char = plr.Character
		if char and char:FindFirstChild("HumanoidRootPart") then
			local hum = char:FindFirstChild("Humanoid")
			if hum and hum.Health > 0 then
				table.insert(t, char)
			end
		end
	end

	return t
end

local PRIORITY_PARTS = {
	"HumanoidRootPart",
	"Head",
	"UpperTorso",
	"LowerTorso"
}

local function hitTarget(tool, touch, char)

	for i = 1, #PRIORITY_PARTS do
		local part = char:FindFirstChild(PRIORITY_PARTS[i])

		if part and part:IsA("BasePart") then
			firetouchinterest(touch, part, 0)
			firetouchinterest(touch, part, 1)
		end
	end
end

RunService.PreSimulation:Connect(function()

	if not Run then return end
	if #getgenv().configs.TargetList == 0 then return end

	local now = os.clock()
	if now - lastFire < FIRE_RATE then return end
	lastFire = now

	local char = getchar()
	if not char then return end

	local targets = getTargets()
	if #targets == 0 then return end

	-- ⚡ STABILIZATION (CRITICAL)
	RunService.PostSimulation:Wait()

	for _, tool in ipairs(char:GetChildren()) do
		if tool:IsA("Tool") then

			local touch = GetTouchInterest(tool)
			if not touch then continue end

			for _, targetChar in ipairs(targets) do
				hitTarget(tool, touch, targetChar)
			end
		end
	end
end)
