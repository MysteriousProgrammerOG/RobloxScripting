-- DRAGGING ENGINE (Bound strictly to the drag handle to prevent button overriding)
local dragging, dragInput, dragStart, startPos

local function update(input)
    local delta = input.Position - dragStart
    container.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
end

dragHandle.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = container.Position
        
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

dragHandle.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if input == dragInput and dragging then
        update(input)
    end
end)

-- Reach Logic Execution
local function applyReach(tool)
    if tool:IsA("Tool") and tool:FindFirstChild("Handle") then
        local handle = tool.Handle

        if not originalProperties[tool] then
            originalProperties[tool] = {
                Size = handle.Size,
                GripPos = tool.GripPos
            }
        end

        handle.Size = Vector3.new(0.5, 0.5, sizeSetting)
        tool.GripPos = Vector3.new(0, 0, 0)

        if not handle:FindFirstChild("SelectionBox") then
            local selectionBox = Instance.new("SelectionBox")
            selectionBox.Name = "SelectionBox"
            selectionBox.Adornee = handle
            selectionBox.Color3 = Color3.fromRGB(255, 0, 0)
            selectionBox.Parent = handle
        end
        if not handle:FindFirstChild("AntiLag") then
            local antiLag = Instance.new("BoolValue")
            antiLag.Name = "AntiLag"
            antiLag.Parent = handle
        end
    end
end

local function restoreOriginalProperties(tool)
    if tool:IsA("Tool") and tool:FindFirstChild("Handle") and originalProperties[tool] then
        local handle = tool.Handle
        local props = originalProperties[tool]

        handle.Size = props.Size
        tool.GripPos = props.GripPos

        if handle:FindFirstChild("SelectionBox") then handle.SelectionBox:Destroy() end
        if handle:FindFirstChild("AntiLag") then handle.AntiLag:Destroy() end

        originalProperties[tool] = nil
    end
end

-- Refresh and Rebuild UI Dropdown List
local function updateDropdown()
    for _, child in ipairs(dropdownList:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end

    local itemsFound = {}
    local locations = {player:FindFirstChild("Backpack"), player.Character}

    for _, containerObj in ipairs(locations) do
        if containerObj then
            for _, tool in ipairs(containerObj:GetChildren()) do
                if tool:IsA("Tool") and not itemsFound[tool.Name] then
                    itemsFound[tool.Name] = true

                    local itemButton = Instance.new("TextButton")
                    itemButton.Size = UDim2.new(1, 0, 0, 30)
                    itemButton.Font = Enum.Font.SourceSans
                    itemButton.TextSize = 14
                    itemButton.BorderSizePixel = 0
                    
                    if activeReachTools[tool.Name] then
                        itemButton.BackgroundColor3 = Color3.fromRGB(60, 120, 60)
                        itemButton.Text = tool.Name .. " [REACH ON]"
                        itemButton.TextColor3 = Color3.fromRGB(255, 255, 255)
                    else
                        itemButton.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
                        itemButton.Text = tool.Name .. " [OFF]"
                        itemButton.TextColor3 = Color3.fromRGB(180, 180, 180)
                    end

                    itemButton.MouseButton1Click:Connect(function()
                        local targetTool = player.Backpack:FindFirstChild(tool.Name) or (player.Character and player.Character:FindFirstChild(tool.Name))
                        
                        if activeReachTools[tool.Name] then
                            activeReachTools[tool.Name] = nil
                            if targetTool then restoreOriginalProperties(targetTool) end
                        else
                            activeReachTools[tool.Name] = true
                            if targetTool then applyReach(targetTool) end
                        end
                        updateDropdown()
                    end)

                    itemButton.Parent = dropdownList
                end
            end
        end
    end

    local count = 0
    for _ in pairs(itemsFound) do count = count + 1 end
    dropdownList.Size = UDim2.new(1, 0, 0, count * 30)
end

mainButton.MouseButton1Click:Connect(function()
    dropdownList.Visible = not dropdownList.Visible
    if dropdownList.Visible then updateDropdown() end
end)

-- Asset Event Connectors
local function monitorBackpack(backpack)
    backpack.ChildAdded:Connect(function(child)
        if child:IsA("Tool") then
            if activeReachTools[child.Name] then
                applyReach(child)
            end
            if dropdownList.Visible then updateDropdown() end
        end
    end)
    backpack.ChildRemoved:Connect(function() 
        if dropdownList.Visible then updateDropdown() end 
    end)
end

local function onCharacterAdded(character)
    character:WaitForChild("HumanoidRootPart")
    
    character.ChildAdded:Connect(function(child)
        if child:IsA("Tool") and activeReachTools[child.Name] then
            applyReach(child)
        end
    end)

    character.ChildRemoved:Connect(function(child)
        if child:IsA("Tool") then
            restoreOriginalProperties(child)
        end
    end)
end

player.CharacterAdded:Connect(onCharacterAdded)
if player.Character then onCharacterAdded(player.Character) end

player.ChildAdded:Connect(function(child)
    if child:IsA("Backpack") then
        monitorBackpack(child)
    end
end)
if player:FindFirstChild("Backpack") then monitorBackpack(player.Backpack) end
