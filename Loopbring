-- Smooth Animated Toggle
local isOpened = false
local function toggleVisibility()
    isOpened = not isOpened
    local targetSize = isOpened and UDim2.new(0, 240, 0, 200) or UDim2.new(0, 240, 0, 0)
    
    if isOpened then Frame.Visible = true end
    
    local tween = TweenService:Create(Frame, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Size = targetSize})
    tween:Play()
    
    if not isOpened then
        tween.Completed:Connect(function()
            if not isOpened then
                Frame.Visible = false
            end
        end)
    end
end

ToggleButton.MouseButton1Click:Connect(toggleVisibility)

