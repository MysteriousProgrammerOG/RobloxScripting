-- LOOPBRING RUNSERVICE LOOP
------------------------------------------------------------
RunService.PreRender:Connect(function()
    local myChar = LocalPlayer.Character
    if not myChar then return end
    local myHRP = myChar:FindFirstChild("HumanoidRootPart")
    if not myHRP then return end

    local targetCFrame = myHRP.CFrame * CFrame.new(targetOffset, 0, -targetDistance)

    for userId, isActive in pairs(LoopBrings) do
        if isActive then
            local targetPlayer = Players:GetPlayerByUserId(userId)
            if targetPlayer and targetPlayer.Character then
                local targetHRP = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
                local targetHum = targetPlayer.Character:FindFirstChildOfClass("Humanoid")
                
                if targetHRP then
                    targetHRP.CFrame = targetCFrame
                    targetHRP.AssemblyLinearVelocity = Vector3.zero
                    targetHRP.AssemblyAngularVelocity = Vector3.zero
                    
                    if targetHum then
                        targetHum.WalkSpeed = 0
                        targetHum.JumpPower = 0
                    end
                end
            end
        end
    end
end)

-- LoopBring toggle logic
local function loopBring(targetPlayer, button)
    local stroke = button:FindFirstChildOfClass("UIStroke")
    
    if LoopBrings[targetPlayer.UserId] then
        LoopBrings[targetPlayer.UserId] = nil
        button.Text = targetPlayer.Name
        button.BackgroundColor3 = CardBg
        button.TextColor3 = TextColor
        if stroke then stroke.Color = ThickBorder end
        
        if targetPlayer.Character then
            local hum = targetPlayer.Character:FindFirstChildOfClass("Humanoid")
            if hum then
                hum.WalkSpeed = 16
                hum.JumpPower = 50
            end
        end
        return
    end
    
    LoopBrings[targetPlayer.UserId] = true
    button.Text = "★ " .. targetPlayer.Name
    button.BackgroundColor3 = AccentRed
    button.TextColor3 = YellowAccent
    if stroke then stroke.Color = ThickBorder end
end

-- Refresh player list
local function updatePlayerList()
    for _, child in ipairs(ListFrame:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end
    
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local playerButton = Instance.new("TextButton")
            playerButton.Name = player.Name
            playerButton.Size = UDim2.new(1, 0, 0, 30)
            playerButton.BackgroundColor3 = LoopBrings[player.UserId] and AccentRed or CardBg
            playerButton.TextColor3 = LoopBrings[player.UserId] and YellowAccent or TextColor
            playerButton.Font = Enum.Font.FredokaOne
            playerButton.TextSize = 13
            playerButton.AutoButtonColor = false
            playerButton.Text = (LoopBrings[player.UserId] and "★ " or "") .. player.Name
            
            local UICornerPlayer = Instance.new("UICorner")
            UICornerPlayer.CornerRadius = UDim.new(0, 8)
            UICornerPlayer.Parent = playerButton
            
            local ButtonStroke = Instance.new("UIStroke")
            ButtonStroke.Thickness = 2
            ButtonStroke.Color = ThickBorder
            ButtonStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
            ButtonStroke.Parent = playerButton
            
            playerButton.MouseEnter:Connect(function()
                if not LoopBrings[player.UserId] then
                    TweenService:Create(playerButton, TweenInfo.new(0.1), {BackgroundColor3 = AccentRed}):Play()
                end
            end)
            
            playerButton.MouseLeave:Connect(function()
                if not LoopBrings[player.UserId] then
                    TweenService:Create(playerButton, TweenInfo.new(0.1), {BackgroundColor3 = CardBg}):Play()
                end
            end)
            
            playerButton.MouseButton1Click:Connect(function()
                loopBring(player, playerButton)
            end)
            
            playerButton.Parent = ListFrame
        end
    end
end

-- Event Listeners
Players.PlayerAdded:Connect(updatePlayerList)
Players.PlayerRemoving:Connect(function(player)
    LoopBrings[player.UserId] = nil
    updatePlayerList()
end)

updatePlayerList()
