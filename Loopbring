-- Helper function to create stylish cartoony buttons
local function createBarButton(text, width, order)
    local container = Instance.new("Frame")
    container.Size = UDim2.new(0, width, 0, 28)
    container.BackgroundTransparency = 1
    container.LayoutOrder = order
    container.Parent = ToggleFrame

    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 1, 0)
    btn.BackgroundColor3 = CardBg
    btn.Text = text
    btn.Font = Enum.Font.FredokaOne
    btn.TextSize = 13
    btn.TextColor3 = TextColor
    btn.AutoButtonColor = false
    btn.Parent = container

    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(0, 8)
    btnCorner.Parent = btn

    local btnStroke = Instance.new("UIStroke")
    btnStroke.Thickness = 2
    btnStroke.Color = ThickBorder
    btnStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    btnStroke.Parent = btn

    -- Cartoony Hover & Click Animation
    btn.MouseEnter:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.1, Enum.EasingStyle.Back), {
            BackgroundColor3 = AccentRed,
            Size = UDim2.new(1, 2, 1, 2),
            Position = UDim2.new(0, -1, 0, -1)
        }):Play()
    end)

    btn.MouseLeave:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.1), {
            BackgroundColor3 = CardBg,
            Size = UDim2.new(1, 0, 1, 0),
            Position = UDim2.new(0, 0, 0, 0)
        }):Play()
    end)

    btn.MouseButton1Down:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.05), {
            Size = UDim2.new(0.9, 0, 0.9, 0),
            Position = UDim2.new(0.05, 0, 0.05, 0)
        }):Play()
    end)

    return btn
end

